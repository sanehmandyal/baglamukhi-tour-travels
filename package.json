{
  "name": "thakur-tour-and-travels-monorepo",
  "version": "1.0.0",
  "description": "Production Ready MERN Stack SEO-First Tour & Travel Website for Baglamukhi Tour & Travels",
  "scripts": {
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "cd server && npm run seed",
    "build": "cd client && npm run build",
    "start": "cd server && npm start"
  },
  "keywords": ["tour", "travel", "mern", "seo", "himachal", "thakur-travels"],
  "author": "Baglamukhi Tour & Travels",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
